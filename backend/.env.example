# .env.example
# project Configuration
GOOGLE_CLOUD_PROJECT="variant-intake-agents"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_CLOUD_ZONE="us-central1-a"

# API Configuration
PUBLIC_API_DOMAIN="your-api-domain"
PUBLIC_API_PREFIX="your-api-prefix"
SHARED_VCF_BUCKET="gs://brain-genomics"
NETWORK_NAME="your-network-name"

# Vertex AI Configuration
GEMINI_API_KEY="your-gemini-api-key"
AGENT_ENGINE_ID="your-agent-engine-id"

# IAP Configuration
IAP_CLIENT_ID="your-iap-client-id"
IAP_CLIENT_SECRET="your-iap-client-secret"
REASONING_ENGINE_SA="your-reasoning-engine-sa"

# Feature Flags
USE_VERTEX_AI_SESSIONS="false"

# CORS Configuration
CORS_PRODUCTION_ORIGINS="http://localhost:3000, your-production-url"

# Auth Configuration
ALLOWED_AUTH_DOMAINS="your-email-domain"