# --- 3. VEP Cache Setup (one-time) ---

# Create GCS bucket for VEP cache
create-vep-bucket:
  gcloud storage buckets create gs://${GOOGLE_CLOUD_PROJECT}_vep-cache-bucket --project=$GOOGLE_CLOUD_PROJECT --location=$GOOGLE_CLOUD_LOCATION

# Download VEP cache and upload to GCS (Takes significant time)
download-vep-cache:
  mkdir -p ~/vep_cache_data
  cd ~/vep_cache_data && \
    wget https://ftp.ensembl.org/pub/release-113/variation/indexed_vep_cache/homo_sapiens_vep_113_GRCh38.tar.gz && \
    tar -xzvf homo_sapiens_vep_113_GRCh38.tar.gz && \
    gsutil -m cp -r homo_sapiens gs://${GOOGLE_CLOUD_PROJECT}_vep-cache-bucket/

# Create Persistent Disk for VEP Cache
create-vep-disk:
  gcloud compute disks create vep-cache-disk --size=100GB --zone=$GOOGLE_CLOUD_ZONE --project=$GOOGLE_CLOUD_PROJECT

# Create temporary VM to load the cache data
create-cache-loader-vm:
  gcloud compute instances create cache-loader --zone=$GOOGLE_CLOUD_ZONE --disk=name=vep-cache-disk,mode=rw --project=$GOOGLE_CLOUD_PROJECT

# SSH into the temporary VM to load the cache data (Manual steps required inside VM)
ssh-cache-loader-vm:
  @echo "Run these commands inside the VM:"
  @echo "sudo mkfs.ext4 /dev/sdb"
  @echo "sudo mkdir -p /mnt/cache/homo_sapiens"
  @echo "sudo mount /dev/sdb /mnt/cache"
  @echo "sudo chmod 777 /mnt/cache/homo_sapiens"
  @echo "gsutil -m cp -r gs://${GOOGLE_CLOUD_PROJECT}_vep-cache-bucket/homo_sapiens/113_GRCh38 /mnt/cache/homo_sapiens/"
  @echo "exit"
  gcloud compute ssh cache-loader --zone=$GOOGLE_CLOUD_ZONE

# Delete the temporary VM
delete-cache-loader-vm:
  gcloud compute instances delete cache-loader --zone=$GOOGLE_CLOUD_ZONE --quiet

