set dotenv-load

# Define defaults for envsubst to pick up
export WORKER_URL := env_var_or_default("WORKER_URL", "http://PENDING-GKE-IP/worker/run-vep")
export VEP_FORK_COUNT := env_var_or_default("VEP_FORK_COUNT", "28")
export GRPC_DNS_RESOLVER := env_var_or_default("GRPC_DNS_RESOLVER", "native")

# Default is this help
default: help

# Print the available recipes
help:
    @just --justfile {{justfile()}} --list

# Build the backend docker image and push it to Google Artifact Registry
build:
  gcloud builds submit --tag=$GOOGLE_CLOUD_LOCATION-docker.pkg.dev/$GOOGLE_CLOUD_PROJECT/prod/genomics-agent:latest

# Deploy the backend to GKE and restart the deployment
deploy:
  envsubst < gke/genomics-deployment.yaml | kubectl apply -f -
  kubectl set env deployment/genomics-agent WORKER_URL=$WORKER_URL
  kubectl rollout restart deployment/genomics-agent

# Deploy the backend to GKE with IAP and restart the deployment
deploy-iap:
  envsubst < gke/genomics-deployment-iap.yaml | kubectl apply -f -
  kubectl set env deployment/genomics-agent WORKER_URL=$WORKER_URL
  kubectl rollout restart deployment/genomics-agent

test-deploy-iap:
  envsubst < gke/genomics-deployment-iap.yaml

# View the status of backend pods in Kubernetes
status:
  kubectl get pods -l app=genomics-agent

# Tail the latest 25 log lines from the backend pods
logs:
  kubectl logs -l app=genomics-agent --tail=25

# Port-forward the backend deployment to localhost:8080
start:
  kubectl port-forward deployment/genomics-agent 8080:8080

# --- 1. Google Cloud Services Setup (One-Time) ---

# Create Firestore Database
setup-firestore:
  gcloud firestore databases create --location=$GOOGLE_CLOUD_LOCATION --project=$GOOGLE_CLOUD_PROJECT

# Create Cloud Tasks Queue
setup-cloud-tasks:
  gcloud tasks queues create $TASKS_QUEUE_NAME \
    --location=$GOOGLE_CLOUD_LOCATION \
    --project=$GOOGLE_CLOUD_PROJECT

# Create Artifact Registry Repository and configure Docker
setup-artifact-registry:
  gcloud artifacts repositories create prod \
    --repository-format=docker \
    --location=$GOOGLE_CLOUD_LOCATION \
    --project=$GOOGLE_CLOUD_PROJECT
  gcloud auth configure-docker $GOOGLE_CLOUD_LOCATION-docker.pkg.dev

# Enable BigQuery API (for gnomAD)
enable-bigquery-api:
  gcloud services enable bigquery.googleapis.com --project=$GOOGLE_CLOUD_PROJECT

# Create GCS bucket for Shared VCF
create-shared-vcf-bucket:
  gcloud storage buckets create gs://${SHARED_VCF_BUCKET} --project=$GOOGLE_CLOUD_PROJECT --location=$GOOGLE_CLOUD_LOCATION

# --- 2. GKE Infrastructure Setup ---

# Create GKE Cluster
create-gke-cluster:
  gcloud container clusters create genomics-cluster \
    --zone=$GOOGLE_CLOUD_ZONE \
    --network=$NETWORK_NAME \
    --subnetwork=gke-nodes \
    --enable-private-nodes \
    --master-ipv4-cidr=172.16.0.0/28 \
    --num-nodes=1 \
    --machine-type=n2d-highmem-32 \
    --workload-pool=$GOOGLE_CLOUD_PROJECT.svc.id.goog \
    --addons GcsFuseCsiDriver \
    --project=$GOOGLE_CLOUD_PROJECT

# Get Cluster Credentials
get-cluster-credentials:
  gcloud container clusters get-credentials genomics-cluster \
    --zone=$GOOGLE_CLOUD_ZONE \
    --project=$GOOGLE_CLOUD_PROJECT

# Create Kubernetes Service Account for the agent
create-k8s-service-account:
  kubectl create serviceaccount genomics-agent-ksa
  kubectl annotate serviceaccount genomics-agent-ksa \
    iam.gke.io/gcp-service-account=firebase-adminsdk-fbsvc@$GOOGLE_CLOUD_PROJECT.iam.gserviceaccount.com

# Set Up Workload Identity Binding
setup-workload-identity:
  gcloud iam service-accounts add-iam-policy-binding \
    firebase-adminsdk-fbsvc@$GOOGLE_CLOUD_PROJECT.iam.gserviceaccount.com \
    --role=roles/iam.workloadIdentityUser \
    --member="serviceAccount:$GOOGLE_CLOUD_PROJECT.svc.id.goog[default/genomics-agent-ksa]" \
    --project=$GOOGLE_CLOUD_PROJECT

# Grant Required IAM Permissions
grant-iam-permissions:
