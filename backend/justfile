# --- 7. Cluster Networking & Firewall Setup ---

# Setup required firewall rules for the GKE cluster
setup-cluster-firewalls:
  #!/usr/bin/env bash
  set -e
  
  echo "Getting Master CIDR..."
  MASTER_CIDR=$(gcloud container clusters describe genomics-cluster --zone=$GOOGLE_CLOUD_ZONE --format="value(privateClusterConfig.masterIpv4CidrBlock)")
  echo "Master CIDR: $MASTER_CIDR"
  
  echo "Getting Node Tag..."
  NODE_TAG=$(gcloud compute instances list --filter="name~gke-genomics-cluster" --limit=1 --format="value(tags.items[0])")
  echo "Node Tag: $NODE_TAG"
  
  echo "Setting up Master to Nodes firewall rule..."
  gcloud compute firewall-rules create gke-genomics-master-to-nodes-fix \
    --network $NETWORK_NAME \
    --priority 1000 \
    --direction INGRESS \
    --action ALLOW \
    --source-ranges=$MASTER_CIDR \
    --target-tags=$NODE_TAG \
    --rules tcp:10250,tcp:443 || \
  gcloud compute firewall-rules update gke-genomics-master-to-nodes-fix \
    --source-ranges=$MASTER_CIDR \
    --target-tags=$NODE_TAG
    
  echo "Setting up GCLB and Health Checks to Nodes firewall rule..."
  gcloud compute firewall-rules create allow-gclb-to-nodes \
    --network $NETWORK_NAME \
    --action ALLOW \
    --direction INGRESS \
    --source-ranges 130.211.0.0/22,35.191.0.0/16 \
    --target-tags $NODE_TAG \
    --rules tcp:3000,tcp:8080,tcp:30000-32767 \
    --description "Allow GCLB and Health Checks to GKE Nodes" || echo "Rule might already exist."
    
  echo "Setting up internal bypass denial firewall rule..."
  gcloud compute firewall-rules create deny-internal-bypass-to-agent \
    --network $NETWORK_NAME \
    --action DENY \
    --direction INGRESS \
    --priority 900 \
    --source-ranges $MASTER_CIDR \
    --target-tags $NODE_TAG \
    --rules tcp:8080 || echo "Rule might already exist."

# --- 8. Domain & Load Balancer Setup ---

# Reserve a global static IP address
reserve-global-ip:
  gcloud compute addresses create my-global-ip \
    --global \
    --project=$GOOGLE_CLOUD_PROJECT

# Create a managed SSL certificate
create-ssl-cert:
  gcloud compute ssl-certificates create genomics-managed-cert \
    --domains=$PUBLIC_API_DOMAIN \
    --global \
    --project=$GOOGLE_CLOUD_PROJECT

# --- 9. HTTPS Load Balancer Setup (Production) ---

export HEALTH_CHECK_NAME := "genomics-api-health-check"
export BACKEND_SERVICE_NAME := "genomics-gke-backend-service"
export URL_MAP_NAME := "genomics-api-url-map"
export HTTPS_PROXY_NAME := "genomics-api-https-proxy"
export FORWARDING_RULE_NAME := "genomics-api-https-rule"
export SSL_CERT_NAME := "genomics-managed-cert"
export STATIC_IP_NAME := "my-global-ip"

# Master recipe to set up the HTTPS Load Balancer
setup-load-balancer: _get-node-port _get-instance-group create-health-check create-backend-service add-backend-to-service create-url-map create-https-proxy create-forwarding-rule
  @echo "Load balancer setup complete. It may take a few minutes for the backend to become healthy."
  @echo "Run 'just check-backend-health' to monitor."

# Helper to get the NodePort
_get-node-port:
  #!/usr/bin/env bash
  export NODE_PORT=$(kubectl get service genomics-agent-service -o=jsonpath='{.spec.ports[?(@.port==80)].nodePort}')
  echo "NodePort is $NODE_PORT"

# Helper to get the instance group name
_get-instance-group:
  #!/usr/bin/env bash
  export INSTANCE_GROUP_NAME=$(gcloud compute instance-groups list --zones=$GOOGLE_CLOUD_ZONE --format="value(name)" --filter="name~gke-genomics-cluster")
  echo "Instance group is $INSTANCE_GROUP_NAME"

# Create Health Check
create-health-check: _get-node-port
  gcloud compute health-checks create http {{HEALTH_CHECK_NAME}} \
    --port=$NODE_PORT \
    --request-path="/health" \
    --check-interval=10s \
    --timeout=5s \
    --unhealthy-threshold=3 \
    --healthy-threshold=2 \
    --global

# Create Backend Service
create-backend-service:
  gcloud compute backend-services create {{BACKEND_SERVICE_NAME}} \
    --protocol=HTTP \
    --health-checks={{HEALTH_CHECK_NAME}} \
    --global

# Add the instance group as a backend
add-backend-to-service: _get-instance-group
  gcloud compute backend-services add-backend {{BACKEND_SERVICE_NAME}} \
    --instance-group=$INSTANCE_GROUP_NAME \
    --instance-group-zone=$GOOGLE_CLOUD_ZONE \
    --balancing-mode=UTILIZATION \
    --max-utilization=0.8 \
    --global

# Create URL Map
create-url-map:
  gcloud compute url-maps create {{URL_MAP_NAME}} \
    --default-service={{BACKEND_SERVICE_NAME}}

# Create HTTPS Proxy
create-https-proxy:
  gcloud compute target-https-proxies create {{HTTPS_PROXY_NAME}} \
    --url-map={{URL_MAP_NAME}} \
    --ssl-certificates={{SSL_CERT_NAME}} \
    --global

# Create Forwarding Rule
create-forwarding-rule:
  gcloud compute forwarding-rules create {{FORWARDING_RULE_NAME}} \
    --address={{STATIC_IP_NAME}} \
    --target-https-proxy={{HTTPS_PROXY_NAME}} \
    --ports=443 \
    --global

# Check backend health
check-backend-health:
  gcloud compute backend-services get-health {{BACKEND_SERVICE_NAME}} --global

# Destroy the HTTPS Load Balancer
destroy-load-balancer:
  gcloud compute forwarding-rules delete {{FORWARDING_RULE_NAME}} --global --quiet
  gcloud compute target-https-proxies delete {{HTTPS_PROXY_NAME}} --global --quiet
  gcloud compute url-maps delete {{URL_MAP_NAME}} --quiet
  gcloud compute backend-services delete {{BACKEND_SERVICE_NAME}} --global --quiet
  gcloud compute health-checks delete {{HEALTH_CHECK_NAME}} --quiet
  gcloud compute ssl-certificates delete {{SSL_CERT_NAME}} --global --quiet
  gcloud compute addresses delete {{STATIC_IP_NAME}} --global --quiet

# Change VM
change-vm:
  gcloud container node-pools update genomics-n2d-pool \
    --cluster genomics-cluster \
    --location=europe-west1-b \
    --machine-type n2d-standard-16 \
    --disk-type pd-ssd \
    --disk-size 100
