enable-iap:
  gcloud services enable iap.googleapis.com --project=$GOOGLE_CLOUD_PROJECT

# Create Cloud Armor security policy
setup-cloud-armor:
  gcloud compute security-policies create genomics-security-policy \
    --description "Policy for genomics-ui and agent"
  gcloud compute security-policies rules update 2147483647 \
    --security-policy genomics-security-policy \
    --action "allow"

# Create Kubernetes Secret for IAP OAuth
setup-iap-secret:
  kubectl create secret generic iap-oauth-secret \
    --from-literal=client_id=$IAP_CLIENT_ID \
    --from-literal=client_secret=$IAP_CLIENT_SECRET

# Grant a user access to bypass IAP (Usage: just grant-iap-access user@example.com)
grant-iap-access user_email:
  gcloud projects add-iam-policy-binding $GOOGLE_CLOUD_PROJECT \
    --member="user:{{user_email}}" \
    --role="roles/iap.httpsResourceAccessor"

